def node_require(script)
  # Resolve script with node to allow for hoisting
  require Pod::Executable.execute_command('node', ['-p',
    "require.resolve(
      '#{script}',
      {paths: [process.argv[1]]},
    )", __dir__]).strip
end

node_require('react-native/scripts/react_native_pods.rb')
node_require('react-native-permissions/scripts/setup.rb')

workspace 'BlueWallet'
platform :ios, min_ios_version_supported
prepare_react_native_project!

setup_permissions(['Camera'])

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'BlueWallet' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )
end

post_install do |installer|
  # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb
  react_native_post_install(
    installer,
    :mac_catalyst_enabled => true
  )
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if ['React-Core-AccessibilityResources'].include? target.name
        config.build_settings['CODE_SIGN_STYLE'] = "Manual"
        config.build_settings['CODE_SIGN_IDENTITY'] = "Apple Distribution: Bluewallet Services, S. R. L. (A7W54YZ4WU)"
        config.build_settings['DEVELOPMENT_TEAM'] = "A7W54YZ4WU"
      end
      # Xcode 26.4+ Apple Clang rejects the consteval paths in the fmt 11.0.2
      # bundled with React Native 0.83 (facebook/react-native#55601, fixed in 0.84+).
      # Force only the fmt pod to C++17 so FMT_USE_CONSTEVAL is skipped.
      if target.name == 'fmt'
        config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
      end
    end
  end

  # Generate a dSYM for the prebuilt hermesvm.framework at archive time.
  # The hermes-engine 0.14.0 prebuilt tarballs ship a stripped framework with
  # no dSYM, which causes App Store Connect's "Upload Symbols" step to fail
  # ("dSYM for hermesvm.framework with the UUIDs [...]" missing). We add a
  # Run Script Build Phase to the BlueWallet target that runs dsymutil on the
  # embedded binary and drops the dSYM into ${DWARF_DSYM_FOLDER_PATH}.
  user_project_path = File.join(__dir__, 'BlueWallet.xcodeproj')
  if File.exist?(user_project_path)
    user_project = Xcodeproj::Project.open(user_project_path)
    hermes_phase_name = '[BW] Generate hermesvm dSYM'
    user_project.targets.each do |target|
      next unless target.name == 'BlueWallet'

      existing = target.shell_script_build_phases.find { |p| p.name == hermes_phase_name }
      target.build_phases.delete(existing) if existing

      phase = target.new_shell_script_build_phase(hermes_phase_name)
      phase.shell_path = '/bin/sh'
      phase.shell_script = <<~SH
        set -e
        # Only run when archiving (Xcode populates DWARF_DSYM_FOLDER_PATH then).
        if [ -z "${DWARF_DSYM_FOLDER_PATH}" ]; then
          exit 0
        fi
        FRAMEWORK_BIN="${TARGET_BUILD_DIR}/${FRAMEWORKS_FOLDER_PATH}/hermesvm.framework/hermesvm"
        if [ ! -f "${FRAMEWORK_BIN}" ]; then
          echo "hermesvm binary not found at ${FRAMEWORK_BIN}; skipping dSYM."
          exit 0
        fi
        DSYM_OUT="${DWARF_DSYM_FOLDER_PATH}/hermesvm.framework.dSYM"
        echo "Generating dSYM for hermesvm.framework -> ${DSYM_OUT}"
        /usr/bin/xcrun dsymutil "${FRAMEWORK_BIN}" -o "${DSYM_OUT}"
      SH
      phase.show_env_vars_in_log = '0'
    end
    user_project.save
  end

  # Fix RCTDeprecation module map error with Xcode 16+/26+ (required for react-native-notifications).
  # The bridging header imports RCTBridgeModule.h which does
  # #import <RCTDeprecation/RCTDeprecation.h>. With -fmodules, Clang treats this
  # as a module import and builds a PCM, but PCH verification then fails with
  # "module 'RCTDeprecation' is not defined in any loaded module map file".
  # Fix: remove RCTDeprecation -fmodule-map-file from the consumer xcconfigs
  # so the import resolves as a plain textual include via HEADER_SEARCH_PATHS.
  # No code uses @import RCTDeprecation, so this is safe.
  installer.generated_aggregate_targets.each do |aggregate_target|
    aggregate_target.xcconfigs.each do |config_name, config|
      xcconfig_path = aggregate_target.xcconfig_path(config_name)
      next unless File.exist?(xcconfig_path)
      content = File.read(xcconfig_path)
      # Order matters: match -Xcc variant first to avoid leaving a dangling -Xcc
      content.gsub!('-Xcc -fmodule-map-file="${PODS_ROOT}/Headers/Public/RCTDeprecation/RCTDeprecation.modulemap" ', '')
      content.gsub!('-fmodule-map-file="${PODS_ROOT}/Headers/Public/RCTDeprecation/RCTDeprecation.modulemap" ', '')
      File.write(xcconfig_path, content)
    end
  end
end
